# ===== 后端 =====
PORT=8080                            # API 监听端口(compose 内网;公网入口=web:443/80)
DATABASE_URL=postgres://postgres:CHANGE_ME@db:5432/hospital_edss?sslmode=disable
                                     # 生产 DSN——口令必须与 POSTGRES_PASSWORD 一致;sslmode 跨机部署按需收紧
DB_MAX_OPEN=25                       # 连接池上限
DB_MAX_IDLE=5                        # 空闲连接数
DB_MAX_LIFETIME_MIN=30               # 连接最大存活(分钟)
LOG_LEVEL=info                       # slog 级别:debug|info|warn|error(生产建议 info,排障再降)
SIM_ENABLED=0                        # 生产=0:/sim/* 不注册(命中 NoRoute 10003)
DEMO_ROLE_SWITCH=0                   # 生产=0:演示角色切换关闭(契约 §2.1 演进注)
                                     #   ?role= 读侧忽略/写侧异名 20004;available_roles 收敛自身一档
AUTH_COOKIE_SECURE=1                 # 生产=1:edss_sid Cookie 追加 Secure(须 HTTPS 入口,见 nginx 443 block)
TRUSTED_PROXY_CIDRS=172.16.0.0/12    # XFF 可信代理;compose 内网网段。直连部署回 127.0.0.1,::1
MIGRATIONS_DIR=                      # edss-migrate 迁移目录(默认 migrations)
SEED_DIR=                            # edss-migrate 种子目录(默认 seed)

# ===== compose =====
SEED_ON_BOOT=                        # 生产置空:不灌演示种子(种子幂等但会把种子域重置成演示锚点)
WEB_PORT=80                          # prod 单端口入口(nginx);TLS 启用后另需 publish 443
BACKEND_PORT=8080                    # backend 仅 127.0.0.1 调试透出
POSTGRES_PASSWORD=                   # compose db 密码——必填,不允许回落演示默认 edss;同时拼进 backend DATABASE_URL
