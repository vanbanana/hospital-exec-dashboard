# 必须填写强口令；不要提交 .env.production。DSN 含特殊字符时应 URL 编码。
POSTGRES_PASSWORD=
DATABASE_URL=
SEED_ON_BOOT=0
SIM_ENABLED=0
DEMO_ROLE_SWITCH=0
AUTH_COOKIE_SECURE=1
SCREEN_PUBLIC=0
TRUSTED_PROXY_CIDRS=172.16.0.0/12
DB_MAX_OPEN=25
DB_MAX_IDLE=5
DB_MAX_LIFETIME_MIN=30
LOG_LEVEL=info
WEB_PORT=80
HTTPS_PORT=443
BACKEND_PORT=8080
# 正式证书文件必须存在。相对路径基于 deploy/。
TLS_CERT_FILE=./certs/edss.crt
TLS_KEY_FILE=./certs/edss.key
