# Install as /etc/edss/ops.env for systemd, or export explicitly for manual commands.
# Project, Compose files, env file and database must match the deployed stack.
EDSS_DEV_PROJECT=edss-dev
EDSS_COMPOSE_FILES=deploy/docker-compose.yml
# Safe deployment: add ,deploy/docker-compose.production.yml and set EDSS_ENV_FILE.
# EDSS_ENV_FILE=.env.production
# Optional assertion; source is derived from the rendered backend DSN.
# EDSS_DB_NAME=hospital_edss
EDSS_API_URL=http://127.0.0.1:8080
EDSS_BACKUP_DIR=backups/automatic
EDSS_BACKUP_KEEP=48
EDSS_BACKUP_TIMEOUT_SECONDS=1800
EDSS_BACKUP_MIN_FREE_BYTES=1073741824
EDSS_BACKUP_MAX_AGE_SECONDS=3900
# Foreground supervisor (ops.py run); timers retain their own configured schedules.
EDSS_BACKUP_INTERVAL_SECONDS=3600
EDSS_MONITOR_INTERVAL_SECONDS=60
EDSS_RESOURCES_INTERVAL_SECONDS=60
EDSS_BACKUP_JOB_TIMEOUT_SECONDS=2400
EDSS_MONITOR_TIMEOUT_SECONDS=5
EDSS_MONITOR_MIN_REQUESTS=20
EDSS_DISK_MAX_USED_PCT=90
EDSS_DB_MAX_IN_USE_PCT=90
EDSS_MAX_ERROR_PCT=1
EDSS_MAX_P95_MS=1000
