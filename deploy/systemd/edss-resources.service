[Unit]
Description=EDSS container resource snapshot
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=edss-ops
WorkingDirectory=/opt/hospital-exec-dashboard
EnvironmentFile=/etc/edss/ops.env
ExecStart=/usr/bin/python3 scripts/ops.py resources
TimeoutStartSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
