# ===== 后端 =====
PORT=8080                            # API 监听端口
DATABASE_URL=postgres://localhost/hospital_edss?sslmode=disable
DB_MAX_OPEN=25                       # 连接池上限
DB_MAX_IDLE=5                        # 空闲连接数
DB_MAX_LIFETIME_MIN=30               # 连接最大存活(分钟)
LOG_LEVEL=info                       # slog 级别:debug|info|warn|error
SIM_ENABLED=1                        # 0=/sim/* 不注册(命中 NoRoute 10003)
AUTH_COOKIE_SECURE=                  # HTTPS 部署置 1:edss_sid Cookie 追加 Secure
TRUSTED_PROXY_CIDRS=                 # XFF 可信代理 CIDR(逗号分隔)。未设/置空:本地跑默认仅回环(置空=不信任任何代理);compose 部署回落 172.16.0.0/12(nginx 容器网段)
MIGRATIONS_DIR=                      # edss-migrate 迁移目录(默认 migrations)
SEED_DIR=                            # edss-migrate 种子目录(默认 seed)

# ===== compose =====
SEED_ON_BOOT=1                       # 1=backend 容器启动前灌演示种子(幂等但重置种子域);置空=只跑迁移
WEB_PORT=80                          # prod 单端口入口(nginx)
BACKEND_PORT=8080                    # backend 仅 127.0.0.1 调试透出
POSTGRES_PASSWORD=edss               # compose db 密码,同时拼进 backend DATABASE_URL

# ===== 前端 dev =====
VITE_USE_MOCK=1                      # 默认 mock;0=真链路经 vite proxy → :8080
