# ===== 后端 =====
PORT=8080                            # API 监听端口
DATABASE_URL=
# 未设时 Go 使用本地库；Compose 使用 db 服务。指定 DSN 必须匹配运行方式。
DB_MAX_OPEN=25                       # 连接池上限
DB_MAX_IDLE=5                        # 空闲连接数
DB_MAX_LIFETIME_MIN=30               # 连接最大存活(分钟)
LOG_LEVEL=info                       # slog 级别:debug|info|warn|error
SIM_ENABLED=1                        # 0=/sim/* 不注册(命中 NoRoute 10003)
AUTH_COOKIE_SECURE=
TRUSTED_PROXY_CIDRS=
MIGRATIONS_DIR=
SEED_DIR=

# ===== compose =====
SEED_ON_BOOT=0                       # 1=backend 容器启动前灌演示种子(幂等但重置种子域);0 或空=只跑迁移
WEB_PORT=80                          # prod 单端口入口(nginx)
BACKEND_PORT=8080                    # backend 仅 127.0.0.1 调试透出
POSTGRES_PASSWORD=edss               # compose db 密码,同时拼进 backend DATABASE_URL

DEMO_ROLE_SWITCH=1
SCREEN_PUBLIC=1
